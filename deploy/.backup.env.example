# TermRelay PostgreSQL backup configuration
# Copy this file to .backup.env on the server. .backup.env is gitignored.

# Keep local backups for this many days.
BACKUP_RETENTION_DAYS=7

# Optional: age public recipient used to encrypt backups before off-server upload.
# IMPORTANT: only the public recipient belongs on the server. Keep the private
# identity/key somewhere controlled by you and off the production server.
# Example: age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BACKUP_AGE_RECIPIENT=

# Optional: rclone destination that is controlled independently from the
# production server. Example: termrelay-backup:termrelay/postgres
BACKUP_RCLONE_REMOTE=

# Verification of encrypted backups needs the private identity. Do NOT set this
# on the production server unless you intentionally want that server to decrypt
# backups. Prefer setting it only on your recovery machine.
# BACKUP_AGE_IDENTITY=/secure/path/termrelay-backup-key.txt

# Safety valve. Keep false unless you explicitly accept uploading plaintext
# database dumps to remote storage.
ALLOW_UNENCRYPTED_REMOTE_BACKUP=false
